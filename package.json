{
  "name": "icona-saas",
  "version": "0.1.0",
  "private": true,
  "description": "ICONA ERP & CRM SaaS for Construction SMEs",
  "scripts": {
    "predev": "powershell -NoProfile -Command \"Get-NetTCPConnection -LocalPort 4266 -State Listen -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue }; if (Test-Path .next) { Remove-Item -Recurse -Force .next }; exit 0\"",
    "dev": "next dev -p 4266",
    "stop": "powershell -NoProfile -Command \"Get-NetTCPConnection -LocalPort 4266 -State Listen -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue }\"",
    "build": "next build",
    "start": "next start -p 4266",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "node --import tsx --test src/lib/utils.test.ts src/lib/entitlements.test.ts src/lib/finance.test.ts src/lib/projectAccess.test.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/react": "^7.0.1",
    "@fullcalendar/timegrid": "^6.1.21",
    "@prisma/client": "^5.16.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "cloudinary": "^2.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "exceljs": "^4.4.0",
    "exifr": "^7.1.3",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.400.0",
    "next": "14.2.35",
    "next-auth": "^4.24.7",
    "next-themes": "^0.3.0",
    "nodemailer": "^9.0.1",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^2.12.7",
    "resend": "^6.17.2",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.5.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "prisma": "^5.16.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.16.0",
    "typescript": "^5"
  }
}
